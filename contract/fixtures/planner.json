{
  "scenario": "planner",
  "description": "The optional planner is off by default and its params are validated",
  "env": {
    "now": 1790762400000,
    "tz": "Asia/Kolkata",
    "seed": "seed.sql"
  },
  "exchanges": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "planner.status"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "enabled": false,
            "provider": "local",
            "state": "off",
            "serverFound": false,
            "modelFound": false,
            "keySet": false,
            "host": "",
            "lastError": null
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "planner.suggest",
        "params": {}
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 2,
          "error": {
            "code": -32603,
            "message": "planner is off"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "planner.suggest"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 3,
          "error": {
            "code": -32603,
            "message": "params: Required"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "planner.suggest",
        "params": {
          "goal": ""
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 4,
          "error": {
            "code": -32603,
            "message": "goal: String must contain at most 500 character(s)"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "planner.suggest",
        "params": {
          "goal": "ok",
          "other": 1
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 5,
          "error": {
            "code": -32603,
            "message": "params: Unrecognized key(s) in object: 'other'"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "planner.categorize"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 6,
          "error": {
            "code": -32603,
            "message": "planner is off"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "planner.categorize",
        "params": {}
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 7,
          "error": {
            "code": -32603,
            "message": "planner is off"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "planner.categorize",
        "params": {
          "appIds": [
            ""
          ]
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 8,
          "error": {
            "code": -32603,
            "message": "appIds.0: String must contain between 1 and 300 character(s)"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "planner.categorize",
        "params": {
          "appIds": "code"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 9,
          "error": {
            "code": -32603,
            "message": "appIds: Expected array, received string"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "planner.setKey",
        "params": {}
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 10,
          "error": {
            "code": -32603,
            "message": "key: Required"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "planner.setKey",
        "params": {
          "key": "has space"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 11,
          "error": {
            "code": -32603,
            "message": "key: must not contain whitespace or control characters"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 12,
        "method": "planner.setKey",
        "params": {
          "key": ""
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 12,
          "error": {
            "code": -32603,
            "message": "key: String must contain at most 512 character(s)"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 13,
        "method": "planner.stop"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 13,
          "result": {
            "ok": true
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 14,
        "method": "planner.stop",
        "params": {}
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 14,
          "error": {
            "code": -32603,
            "message": "params: Expected void, received object"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 15,
        "method": "settings.set",
        "params": {
          "plannerProvider": "remote",
          "plannerEndpoint": "https://api.example.com/v1",
          "plannerModel": "m"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 15,
          "result": {
            "captureTitles": false,
            "idleThresholdMinutes": 5,
            "breakRemindersEnabled": false,
            "breakEveryMinutes": 50,
            "breakLengthMinutes": 5,
            "downtimeEnabled": false,
            "downtimeStart": "22:00",
            "downtimeEnd": "07:00",
            "onboardingDone": true,
            "notchEnabled": true,
            "plannerEnabled": false,
            "plannerProvider": "remote",
            "plannerEndpoint": "https://api.example.com/v1",
            "plannerModel": "m",
            "plannerServerPath": "",
            "plannerModelPath": "",
            "plannerIdleMinutes": 5
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 16,
        "method": "planner.status"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 16,
          "result": {
            "enabled": false,
            "provider": "remote",
            "state": "off",
            "serverFound": false,
            "modelFound": false,
            "keySet": false,
            "host": "api.example.com",
            "lastError": null
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 17,
        "method": "settings.set",
        "params": {
          "plannerProvider": "cloud"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 17,
          "error": {
            "code": -32603,
            "message": "plannerProvider: Invalid enum value. Expected 'local' | 'remote', received 'cloud'"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 18,
        "method": "settings.set",
        "params": {
          "plannerEndpoint": "ftp://x"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 18,
          "error": {
            "code": -32603,
            "message": "plannerEndpoint: expected an http(s) URL"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 19,
        "method": "settings.set",
        "params": {
          "plannerIdleMinutes": 0
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 19,
          "error": {
            "code": -32603,
            "message": "plannerIdleMinutes: Number must be greater than or equal to 1"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 20,
        "method": "settings.set",
        "params": {
          "plannerIdleMinutes": 61
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 20,
          "error": {
            "code": -32603,
            "message": "plannerIdleMinutes: Number must be less than or equal to 60"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 21,
        "method": "planner.setKey",
        "params": {
          "key": ""
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 21,
          "result": {
            "ok": true
          }
        }
      ]
    }
  ]
}

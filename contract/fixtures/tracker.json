{
  "scenario": "tracker",
  "description": "Pausing and resuming tracking",
  "env": {
    "now": 1790762400000,
    "tz": "Asia/Kolkata",
    "seed": "seed.sql"
  },
  "exchanges": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tracker.pause",
        "params": {
          "minutes": 15
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "method": "event.status",
          "params": {
            "paused": true,
            "resumeAt": 1790763300000,
            "idle": false,
            "currentAppId": null,
            "since": null,
            "focusMode": {
              "active": false,
              "until": null
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "resumeAt": 1790763300000
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tracker.status"
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 2,
          "result": {
            "paused": true,

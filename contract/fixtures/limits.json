{
  "scenario": "limits",
  "description": "Creating, updating and deleting limits",
  "env": {
    "now": 1790762400000,
    "tz": "Asia/Kolkata",
    "seed": "seed.sql"
  },
  "exchanges": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "limits.set",
        "params": {
          "targetType": "app",
          "target": "code",
          "dailyMs": 7200000,
          "action": "notify"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "id": 4,
            "targetType": "app",
            "target": "code",
            "dailyMs": 7200000,
            "action": "notify"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "limits.set",
        "params": {
          "targetType": "domain",
          "target": "reddit.com",
          "dailyMs": 900000,
          "action": "overlay",
          "schedule": "22:00-06:00"
        }
      },
      "receive": [
        {
          "jsonrpc": "2.0",
          "id": 2,
          "result": {
            "id": 5,

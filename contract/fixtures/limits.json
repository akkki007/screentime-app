          "result": {
            "id": 1,
            "targetType": "app",
            "target": "com.spotify.Client",
            "dailyMs": 2700000,
            "action": "overlay"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "limits.set",
        "params": {
          "targetType": "domain",
          "target": "youtube.com",
          "dailyMs": 60000,
